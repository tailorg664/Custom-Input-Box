{
  "manifest_version": 3,
  "name": "Floating Input Sync",
  "version": "1.0",
  "description": "A floating input box that syncs with any focused input or textarea.",
  "permissions": ["scripting", "activeTab", "tabs","storage"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icons/icon.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["style.css"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "scripts": ["background.js"]
  }
}
